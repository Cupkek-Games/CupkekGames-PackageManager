/* ── Header ── */

.pm-header {
    padding: 14px 18px 12px 18px;
    background-color: var(--editor-bg-750);
    border-bottom-width: 1px;
    border-bottom-color: var(--editor-border-medium);
}

.pm-header-title {
    font-size: 16px;
    -unity-font-style: bold;
    color: var(--editor-text-primary);
    margin-bottom: 4px;
}

.pm-header-subtitle {
    font-size: 11px;
    color: var(--editor-text-muted);
    white-space: normal;
}

/* Inline link button under the subtitle paragraph — looks like a text
 * link, not a button, so it doesn't compete with the toolbar actions. */
.pm-header-link {
    font-size: 11px;
    -unity-font-style: bold;
    color: var(--editor-link);
    background-color: transparent;
    border-width: 0;
    padding: 4px 0 0 0;
    margin: 0;
    align-self: flex-start;
}

.pm-header-link:hover {
    color: var(--editor-text-primary);
}

/* ── Section header ──
 * Splits the rows scroll into "CupkekGames Packages" and the
 * "External Dependencies (optional)" trailing section. */

.pm-section-header {
    margin: 6px 0 4px 2px;
}

.pm-section-header-text {
    font-size: 12px;
    -unity-font-style: bold;
    color: var(--editor-text-primary);
}

.pm-section-header-sub {
    font-size: 11px;
    color: var(--editor-text-muted);
    white-space: normal;
    margin-top: 2px;
}

/* The first section header sits at the top of the rows scroll — it has
 * no preceding content, so trim its top margin to keep alignment. */
.pm-rows-scroll > .pm-section-header:first-child {
    margin-top: 0;
}

/* ── Content ── */

.pm-content {
    flex-grow: 1;
    padding: 12px 14px;
    background-color: var(--editor-bg-850);
}

/* ── Toolbar ── */

.pm-toolbar {
    flex-direction: row;
    align-items: center;
    margin-bottom: 10px;
}

.pm-toolbar-count {
    flex-direction: row;
    align-items: center;
}

.pm-toolbar-count-text {
    font-size: 12px;
    -unity-font-style: bold;
    padding: 4px 10px;
    border-radius: 10px;
    border-width: 1px;
}

.pm-toolbar-count-text--ok {
    color: var(--editor-success-fg);
    background-color: var(--editor-success-bg);
    border-color: var(--editor-success-border);
}

.pm-toolbar-count-text--missing {
    color: var(--editor-danger-fg);
    background-color: var(--editor-danger-bg);
    border-color: var(--editor-danger-border);
}

.pm-toolbar-btn {
    margin-left: 8px;
    min-height: 26px;
    padding: 0 12px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    border-width: 1px;
    border-color: var(--editor-border-soft);
    background-color: var(--editor-surface-weak);
    color: var(--editor-text-secondary);
}

.pm-toolbar-btn--primary {
    -unity-font-style: bold;
    border-color: var(--editor-brand-border);
    background-color: var(--editor-brand-bg);
}

/* Update All — distinct from "primary" so it reads as "newer thing
 * available" rather than "default action". Amber-ish to differentiate
 * from the green-leaning primary install button. */
.pm-toolbar-btn--update {
    -unity-font-style: bold;
    border-color: rgba(220, 160, 50, 0.65);
    background-color: rgba(120, 80, 20, 0.55);
    color: rgb(255, 220, 160);
}

.pm-toolbar-btn:disabled {
    opacity: 0.5;
}

/* ── Rows ── */

.pm-rows-scroll {
    flex-grow: 1;
}

.pm-row {
    flex-direction: row;
    align-items: center;
    padding: 6px 10px;
    margin-bottom: 4px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    background-color: var(--editor-surface-weak);
    border-width: 1px;
    border-color: var(--editor-border-soft);
}

.pm-row--installed {
    border-color: rgba(73, 204, 91, 0.3);
}

.pm-row--missing {
    border-color: rgba(204, 74, 74, 0.3);
}

.pm-row-icon {
    width: 10px;
    height: 10px;
    min-width: 10px;
    min-height: 10px;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
    margin-right: 10px;
}

.pm-row-icon--installed {
    background-color: rgb(73, 204, 91);
}

.pm-row-icon--missing {
    background-color: rgb(204, 74, 74);
}

.pm-row-displayname {
    font-size: 12px;
    -unity-font-style: bold;
    color: var(--editor-text-primary);
    margin-right: 10px;
    min-width: 110px;
}

.pm-row-packageid {
    font-size: 11px;
    color: var(--editor-text-muted);
    margin-right: 8px;
}

.pm-row-tags {
    flex-direction: row;
    align-items: center;
}

.pm-row-tag {
    font-size: 10px;
    -unity-font-style: bold;
    color: var(--editor-text-secondary);
    background-color: var(--editor-surface-weak);
    border-color: var(--editor-border-soft);
    border-width: 1px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    padding: 1px 7px;
    margin-right: 4px;
}

.pm-row-version {
    font-size: 11px;
    color: var(--editor-text-secondary);
    margin-right: 4px;
    padding: 2px 8px;
    border-radius: 4px;
    background-color: rgba(255, 255, 255, 0.04);
}

.pm-row-install-btn {
    min-width: 80px;
    min-height: 22px;
    padding: 0 10px;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
    border-width: 1px;
    border-color: var(--editor-brand-border);
    background-color: var(--editor-brand-bg);
    color: var(--editor-text-secondary);
}

/* Per-row Docs link — minimal text-link styling so it doesn't compete
 * with the install/update action button next to it. */
.pm-row-docs-btn {
    font-size: 11px;
    color: var(--editor-link);
    background-color: transparent;
    border-width: 0;
    min-width: 0;
    min-height: 22px;
    padding: 0 8px;
    margin-right: 2px;
}

.pm-row-docs-btn:hover {
    color: var(--editor-text-primary);
}

/* Per-row Update button — slightly wider to fit "Update v0.2.4" labels
 * comfortably, amber-tinted so it visually pairs with the toolbar
 * Update All button. */
.pm-row-install-btn--update {
    min-width: 110px;
    border-color: rgba(220, 160, 50, 0.65);
    background-color: rgba(120, 80, 20, 0.55);
    color: rgb(255, 220, 160);
}

/* ── Misc ── */

.pm-loading-text {
    font-size: 12px;
    color: var(--editor-text-muted);
    -unity-font-style: italic;
    padding: 8px 10px;
}

.pm-error-label {
    font-size: 11px;
    color: rgb(204, 74, 74);
    background-color: rgba(204, 74, 74, 0.1);
    border-radius: 4px;
    padding: 6px 10px;
    margin-top: 8px;
    white-space: normal;
}
